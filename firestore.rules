rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles collection
    match /users/{userId} {
      // Users can only read their own profile
      allow read: if isOwner(userId);

      // On creation, ensure user is creating their own profile with valid initial fields
      allow create: if isOwner(userId)
        && request.resource.data.firebaseUid == userId
        && request.resource.data.participationType in ['TRUCK_DRIVER', 'TRUCK_OPERATOR', 'CARGO_OWNER']
        && request.resource.data.name is string
        && request.resource.data.email is string;

      // On update, prevent changes to protected authorization and system fields
      allow update: if isOwner(userId)
        && request.resource.data.firebaseUid == resource.data.firebaseUid
        && request.resource.data.participationType == resource.data.participationType
        && (!('accountStatus' in resource.data) || request.resource.data.accountStatus == resource.data.accountStatus);
    }

    // Truck listings collection
    match /trucks/{truckId} {
      // Authenticated users can read available marketplace listings or their own listings (including inactive)
      allow read: if isAuthenticated()
        && (resource.data.status == 'available' || resource.data.ownerUid == request.auth.uid);

      // On create, ownerUid must match authenticated user and valid payload values
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.registrationNumber is string
        && request.resource.data.registrationNumber.size() > 0
        && request.resource.data.truckType is string
        && request.resource.data.maxPayloadKg is number
        && request.resource.data.maxPayloadKg > 0
        && request.resource.data.status in ['available', 'inactive'];

      // On update, ownerUid must match authenticated user and remain unchanged
      allow update: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.maxPayloadKg is number
        && request.resource.data.maxPayloadKg > 0
        && request.resource.data.status in ['available', 'inactive'];

      // On delete, only the document owner can delete
      allow delete: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
    }

    // Cargo requirements collection
    match /cargo/{cargoId} {
      // Authenticated users can read available marketplace cargo requirements or their own listings (including inactive)
      allow read: if isAuthenticated()
        && (resource.data.status == 'available' || resource.data.ownerUid == request.auth.uid);

      // On create, ownerUid must match authenticated user and valid weight values
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.cargoType is string
        && request.resource.data.cargoType.size() > 0
        && request.resource.data.weightKg is number
        && request.resource.data.weightKg > 0
        && request.resource.data.pickupLocation is string
        && request.resource.data.pickupLocation.size() > 0
        && request.resource.data.status in ['available', 'inactive', 'booked'];

      // On update, ownerUid must match authenticated user and remain unchanged
      allow update: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.weightKg is number
        && request.resource.data.weightKg > 0
        && request.resource.data.status in ['available', 'inactive', 'booked'];

      // On delete, only the document owner can delete
      allow delete: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
